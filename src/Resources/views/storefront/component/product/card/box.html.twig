{% sw_extends '@Storefront/storefront/component/product/card/box.html.twig' %}

{# Setzt das Sub-Layout, sobald der Subscriber das minimalistische Layout meldet. Der Dispatcher des Kerns
   in component_product_box_include bindet dann box-rc-minimalistic.html.twig ein.

   Gefragt wird zuerst der Request, dann die Seite. Beim Nachladen über /widgets/cms/navigation/{id}, also
   bei jedem Filter- und Seitenwechsel, steht hier weder `page` noch das Listing-Ergebnis zur Verfügung;
   fragte die Vorlage nur die Seite, kämen beim Blättern Standard-Kacheln. Die Seite bleibt der Rückfall
   für Aufrufe, bei denen der Subscriber am Request nichts entschieden hat. #}
{% block component_product_box_include %}
    {% set rcMinimalisticActive = app.request.attributes.get('rcMinimalisticLayoutActive')
        ?? (page.extensions.rcMinimalisticLayout.active ?? false) %}

    {% if rcMinimalisticActive %}
        {% set layout = 'rc-minimalistic' %}
    {% endif %}

    {{ parent() }}
{% endblock %}
