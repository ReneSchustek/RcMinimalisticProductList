<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Ruhrcoder\RcMinimalisticProductList\Service\LayoutDecision">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Ruhrcoder\RcMinimalisticProductList\Subscriber\ListingLayoutSubscriber">
            <argument type="service" id="category.repository"/>
            <argument type="service" id="Ruhrcoder\RcMinimalisticProductList\Service\LayoutDecision"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!--
            CustomFieldsInstaller wird bewusst NICHT als Service registriert: er läuft nur in
            den Lifecycle-Methoden (install/update/activate/uninstall), wo plugin-eigene Services
            nicht im DI-Container sind. Er wird dort direkt mit den Core-Repositories instanziiert.
        -->
    </services>
</container>
