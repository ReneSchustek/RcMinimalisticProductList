<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Ruhrcoder\RcMinimalisticProductList\Service\LayoutDecision">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Ruhrcoder\RcMinimalisticProductList\Subscriber\ListingLayoutSubscriber">
            <argument type="service" id="category.repository"/>
            <argument type="service" id="Ruhrcoder\RcMinimalisticProductList\Service\LayoutDecision"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!--
            Der CustomFieldsInstaller fehlt hier, weil er nur in den Lebenszyklus-Methoden läuft
            (install, update, activate, uninstall). Dort stehen die Dienste des Plugins noch nicht im
            Container; die Plugin-Klasse baut ihn mit den Repositories des Kerns.
        -->
    </services>
</container>
