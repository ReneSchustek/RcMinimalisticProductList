{
    "name": "ruhrcoder/rc-minimalistic-product-list",
    "description": "Shows a minimalistic product list",
    "type": "shopware-platform-plugin",
    "version": "1.3.5",
    "license": "MIT",
    "authors": [
        {
            "name": "Ruhrcoder (René Schustek)",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.7.0 || ~6.8.0",
        "shopware/storefront": "~6.7.0 || ~6.8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.0",
        "shopwarelabs/phpstan-shopware": "^0.2"
    },
    "extra": {
        "shopware-plugin-class": "Ruhrcoder\\RcMinimalisticProductList\\RcMinimalisticProductList",
        "label": {
            "de-DE": "Minimalistische Produktliste",
            "en-GB": "Minimalistic Product List"
        },
        "description": {
            "de-DE": "Zeigt eine Produktliste an, die nur aus Bild, Titel und Preis besteht.",
            "en-GB": "Shows a productlist which only contains picture, title and price."
        },
        "remarks": {
            "de-DE": "Minimalistische Produktliste anzeigen.",
            "en-GB": "Show the minimalistic product list."
        }
    },
    "autoload": {
        "psr-4": {
            "Ruhrcoder\\RcMinimalisticProductList\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruhrcoder\\RcMinimalisticProductList\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.0"
        },
        "audit": {
            "ignore": {
                "PKSA-p9gd-j6gr-6f9t": "Betroffen ist allein der MCP-Client (Mcp\\Client\\Transport\\HttpTransport): Sein SSE-Puffer wächst unbegrenzt, wenn der Gegenserver die Leerzeile zurückhält. Shopware nutzt ausschließlich die Server-Seite (StreamableHttpTransport); im Kern 6.7.13.0 und in allen Rc-Erweiterungen: null Aufrufe der Client-Klassen. Behoben ist mcp/sdk 0.7.1, doch shopware/core pinnt bis 6.7.13.0 auf ^0.6.0 und kann sie nicht ziehen. Wieder vorlegen: 2026-11-01."
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "quality": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    }
}
